{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    /* Access outside the working directory is an explicit boundary. */
    "external_directory": {
      "*": "ask"
    },
    /*
     * Default to approval. Allow routine inspection, local development,
     * and passive analysis; keep external, destructive, privileged, and
     * publishing actions behind approval.
     */
    "bash": {
      "*": "ask",

      // Machine context and process inspection.
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "tree": "allow",
      "tree *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "du *": "allow",
      "df *": "allow",
      "which *": "allow",
      "command -v *": "allow",
      "whoami": "allow",
      "id": "allow",
      "date": "allow",
      "date *": "allow",
      "uname": "allow",
      "uname *": "allow",
      "sw_vers": "allow",
      "ps *": "allow",
      "pgrep *": "allow",
      "lsof *": "allow",

      // Read-only text and source inspection.
      "rg *": "allow",
      "grep *": "allow",
      "fd *": "allow",
      "jq *": "allow",
      "yq *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "sed -n *": "allow",
      "diff *": "allow",
      "cmp *": "allow",

      // Reversible local file operations.
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "mv *": "allow",

      // Local repository work is autonomous; remote and destructive boundaries ask.
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git merge-base*": "allow",
      "git ls-files*": "allow",
      "git ls-tree*": "allow",
      "git blame*": "allow",
      "git grep*": "allow",
      "git describe*": "allow",
      "git branch*": "allow",
      "git tag*": "allow",
      "git fetch*": "allow",
      "git pull*": "allow",
      "git clone*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git switch*": "allow",
      "git checkout*": "allow",
      "git merge*": "allow",
      "git rebase*": "allow",
      "git cherry-pick*": "allow",
      "git stash*": "allow",
      "git push*": "ask",
      "git clean*": "ask",
      "git reset --hard*": "ask",
      "git restore*": "ask",
      "git checkout -- *": "ask",
      "git branch -D*": "ask",
      "git switch -C*": "ask",
      "git switch --discard-changes*": "ask",
      "git remote add*": "ask",
      "git remote remove*": "ask",
      "git remote rename*": "ask",
      "git remote set-url*": "ask",
      "git config --global*": "ask",
      "git config --system*": "ask",

      // Normal package execution is allowed; registry and credential changes ask.
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "bun *": "allow",
      "corepack *": "allow",
      "npm publish*": "ask",
      "npm unpublish*": "ask",
      "npm deprecate*": "ask",
      "npm access*": "ask",
      "npm owner*": "ask",
      "npm team*": "ask",
      "npm token*": "ask",
      "npm profile*": "ask",
      "npm login*": "ask",
      "npm logout*": "ask",
      "npm config*": "ask",
      "pnpm publish*": "ask",
      "pnpm login*": "ask",
      "pnpm logout*": "ask",
      "pnpm config*": "ask",
      "yarn npm publish*": "ask",
      "yarn npm login*": "ask",
      "yarn npm logout*": "ask",
      "bun publish*": "ask",

      // Test, lint, format, and dependency workflows.
      "pytest *": "allow",
      "python -m pytest *": "allow",
      "python3 -m pytest *": "allow",
      "tox *": "allow",
      "nox *": "allow",
      "ruff *": "allow",
      "mypy *": "allow",
      "flake8 *": "allow",
      "black *": "allow",
      "isort *": "allow",
      "pip *": "allow",
      "pip3 *": "allow",
      "python -m pip *": "allow",
      "python3 -m pip *": "allow",
      "uv *": "allow",
      "poetry *": "allow",
      "pip config*": "ask",
      "pip3 config*": "ask",
      "uv publish*": "ask",
      "poetry publish*": "ask",
      "twine upload*": "ask",

      // Common build and test toolchains. Deployment and publication remain guarded.
      "make *": "allow",
      "just *": "allow",
      "task *": "allow",
      "go test*": "allow",
      "go build*": "allow",
      "go vet*": "allow",
      "go generate*": "allow",
      "go mod *": "allow",
      "govulncheck *": "allow",
      "golangci-lint *": "allow",
      "go env -w*": "ask",
      "cargo *": "allow",
      "cargo publish*": "ask",
      "cargo yank*": "ask",
      "cargo login*": "ask",
      "mvn *": "allow",
      "./mvnw *": "allow",
      "mvn *deploy*": "ask",
      "./mvnw *deploy*": "ask",
      "gradle *": "allow",
      "./gradlew *": "allow",
      "gradle *publish*": "ask",
      "./gradlew *publish*": "ask",
      "dotnet *": "allow",
      "dotnet nuget push*": "ask",
      "dotnet nuget delete*": "ask",
      "composer *": "allow",
      "composer global*": "ask",
      "composer config --global*": "ask",
      "eslint *": "allow",
      "prettier *": "allow",
      "tsc *": "allow",
      "jest *": "allow",
      "vitest *": "allow",

      // Container inspection and development workflows; host escape and registry actions ask.
      "docker ps*": "allow",
      "docker images*": "allow",
      "docker inspect*": "allow",
      "docker logs*": "allow",
      "docker stats*": "allow",
      "docker build*": "allow",
      "docker compose *": "allow",
      "docker run *": "allow",
      "docker run *--privileged*": "ask",
      "docker run *--pid=host*": "ask",
      "docker run *--network=host*": "ask",
      "docker run *-v /*": "ask",
      "docker run *--mount*source=/*": "ask",
      "docker push*": "ask",
      "docker login*": "ask",
      "docker logout*": "ask",
      "docker system prune*": "ask",
      "docker volume rm*": "ask",

      // Plans and validation are read-only; state-changing operations require approval.
      "terraform version*": "allow",
      "terraform fmt*": "allow",
      "terraform validate*": "allow",
      "terraform init*": "allow",
      "terraform plan*": "allow",
      "terraform show*": "allow",
      "terraform providers*": "allow",
      "terraform graph*": "allow",
      "terraform apply*": "ask",
      "terraform destroy*": "ask",
      "terraform import*": "ask",
      "terraform taint*": "ask",
      "terraform untaint*": "ask",
      "terraform force-unlock*": "ask",
      "terraform state mv*": "ask",
      "terraform state rm*": "ask",
      "terraform state push*": "ask",
      "tofu version*": "allow",
      "tofu fmt*": "allow",
      "tofu validate*": "allow",
      "tofu init*": "allow",
      "tofu plan*": "allow",
      "tofu show*": "allow",
      "tofu apply*": "ask",
      "tofu destroy*": "ask",
      "tofu import*": "ask",
      "tofu state mv*": "ask",
      "tofu state rm*": "ask",
      "tofu state push*": "ask",

      // Cluster and chart inspection. Mutating cluster operations remain covered by the default.
      "kubectl get *": "allow",
      "kubectl describe *": "allow",
      "kubectl logs *": "allow",
      "kubectl diff *": "allow",
      "kubectl explain *": "allow",
      "kubectl api-resources*": "allow",
      "kubectl api-versions*": "allow",
      "kubectl auth can-i*": "allow",
      "kubectl config current-context*": "allow",
      "helm list*": "allow",
      "helm status*": "allow",
      "helm history*": "allow",
      "helm get *": "allow",
      "helm show *": "allow",
      "helm template *": "allow",
      "helm lint *": "allow",
      "helm repo list*": "allow",

      // Cloud inspection is limited to identity, inventory, metadata, and audit queries.
      // Avoid broad read rules because some commands expose secrets.
      "aws sts get-caller-identity*": "allow",
      "aws configure list*": "allow",
      "aws * list-*": "allow",
      "aws * describe-*": "allow",
      "aws s3 ls*": "allow",
      "aws cloudtrail lookup-events*": "allow",
      "aws logs filter-log-events*": "allow",
      "aws logs get-log-events*": "allow",
      "gcloud auth list*": "allow",
      "gcloud config list*": "allow",
      "gcloud * list*": "allow",
      "gcloud * describe*": "allow",
      "gcloud logging read*": "allow",
      "az account list*": "allow",
      "az account show*": "allow",
      "az * list*": "allow",

      // Local and passive security analysis.
      "semgrep *": "allow",
      "trivy fs *": "allow",
      "trivy config *": "allow",
      "trivy image *": "allow",
      "grype *": "allow",
      "syft *": "allow",
      "osv-scanner *": "allow",
      "gitleaks detect *": "allow",
      "gitleaks protect *": "allow",
      "detect-secrets scan *": "allow",
      "bandit *": "allow",
      "gosec *": "allow",
      "checkov *": "allow",
      "kics scan *": "allow",
      "hadolint *": "allow",
      "shellcheck *": "allow",
      "pip-audit *": "allow",
      "npm audit*": "allow",
      "pnpm audit*": "allow",
      "yarn audit*": "allow",
      "cargo audit*": "allow",

      // Low-impact network diagnostics. General network access remains guarded.
      "dig *": "allow",
      "nslookup *": "allow",
      "host *": "allow",
      "whois *": "allow",
      "ping *": "allow",
      "openssl s_client *": "allow",

      // Read-only repository, pull request, issue, workflow, and API queries.
      "gh repo view*": "allow",
      "gh pr list*": "allow",
      "gh pr view*": "allow",
      "gh pr diff*": "allow",
      "gh pr checks*": "allow",
      "gh pr status*": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh issue status*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh run watch*": "allow",
      "gh workflow list*": "allow",
      "gh workflow view*": "allow",
      "gh search *": "allow",
      "gh api --method GET *": "allow",
      "gh api -X GET *": "allow",

      // Privilege escalation, deletion, process control, system changes, and remote access.
      "sudo*": "ask",
      "su *": "ask",
      "rm *": "ask",
      "shred *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "chmod *": "ask",
      "chmod +x *": "allow",
      "chown *": "ask",
      "kill *": "ask",
      "pkill *": "ask",
      "launchctl *": "ask",
      "systemctl *": "ask",
      "brew install*": "ask",
      "brew uninstall*": "ask",
      "brew upgrade*": "ask",
      "apt *": "ask",
      "apt-get *": "ask",
      "dnf *": "ask",
      "yum *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "curl *": "ask",
      "curl -I *": "allow",
      "curl --head *": "allow",
      "wget *": "ask",
      "wget --spider *": "allow",
      "nc *": "ask",
      "netcat *": "ask",
      "socat *": "ask",
      "op *": "ask",
      "pass *": "ask",
      "security *": "ask",
      "nmap *": "ask",
      "masscan *": "ask",
      "nuclei *": "ask",
      "ffuf *": "ask",
      "gobuster *": "ask",
      "dirsearch *": "ask",
      "nikto *": "ask",
      "sqlmap *": "ask",
      "hydra *": "ask",
      "wpscan *": "ask"
    },
    /* Browser observation and navigation are low-impact; interaction and arbitrary control ask. */
    "chrome-devtools_*": "ask",
    "chrome-devtools_list_*": "allow",
    "chrome-devtools_get_*": "allow",
    "chrome-devtools_take_*": "allow",
    "chrome-devtools_performance_*": "allow",
    "chrome-devtools_lighthouse_audit": "allow",
    "chrome-devtools_select_page": "allow",
    "chrome-devtools_new_page": "allow",
    "chrome-devtools_navigate_page": "allow",
    "chrome-devtools_wait_for": "allow",
    "chrome-devtools_hover": "allow",
    "chrome-devtools_resize_page": "allow",
    /* Read operations are autonomous; repository mutations require approval. */
    "github_*": "ask",
    "github_get*": "allow",
    "github_list*": "allow",
    "github_search*": "allow",
    "github_issue_read": "allow",
    "github_pull_request_read": "allow",
    /* Read operations are autonomous; issue, page, and workflow mutations require approval. */
    "atlassian_*": "ask",
    "atlassian_get*": "allow",
    "atlassian_search*": "allow",
    "atlassian_lookup*": "allow",
    "atlassian_fetch": "allow",
    "atlassian_atlassianUserInfo": "allow",
    /* Search-only services do not mutate external state. */
    "bravesearch_*": "allow",
    "exasearch_*": "allow"
  }
}
